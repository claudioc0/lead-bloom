# Supabase (publishable keys only — safe for Vite client bundle)
# Dashboard: Project Settings → API → Project URL + anon public (legacy) key
# The JWT "ref" claim must match your project ref exactly (e.g. cozoxvpdfifvmqukpiyy).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Dev auth: Supabase Dashboard → Authentication → Providers → Email
# Turn OFF "Confirm email" to avoid signup emails and "email rate limit exceeded" while testing.

# Edge Function secrets (configure in Supabase Dashboard → Edge Functions → Secrets)
# OPENAI_API_KEY=           # Phase 2: real AI messages
# YOUTUBE_API_KEY=          # Phase 2: YouTube Data API v3
